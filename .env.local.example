# Environment Variables
# Copy this file to .env.local and fill in the values

# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk Auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SIGNING_SECRET=
CLERK_JWT_ISSUER=

# Groq API (free tier)
GROQ_API_KEY=

# Cerebras API (free tier, 1M tokens/day)
CEREBRAS_API_KEY=

# Gemini API (Embedding + Flash; free tier)
GEMINI_API_KEY=

# Upstash Redis (rate limiting only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (error tracking)
SENTRY_DSN=

# Cron secret for scheduled tasks
CRON_SECRET=

# Admin emails (comma-separated, seeded as admin on first sign-in)
ADMIN_EMAILS=