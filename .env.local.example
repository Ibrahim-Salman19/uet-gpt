# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk Authentication
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SIGNING_SECRET=
CLERK_JWT_ISSUER=

# LLM Providers
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Gemini embedding key pool. convex/embeddings/generate.ts tries these IN ORDER and
# rotates to the next ONLY on auth/quota errors; deterministic errors fail fast. When
# every key is exhausted/rate-limited the call fails closed (no silent degradation).
# All four are SERVER-ONLY secrets — never expose any as NEXT_PUBLIC_*. At least
# GEMINI_API_KEY must be set (it is also the chat fallback key).
GEMINI_API_KEY=           # Primary key (embeddings + chat fallback). Required.
GEMINI_API_KEY_1=         # Rotation key #1 (embeddings). Optional.
GEMINI_API_KEY_2=         # Rotation key #2 (embeddings). Optional.
GOOGLE_GENERATIVE_AI_API_KEY=  # Final rotation key (embeddings). Optional.

# Rate Limiting (Upstash Redis — rate limit only; semantic cache is Convex-native)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring
# Server/build + edge DSN. Also gates Sentry wrapping in next.config.ts.
SENTRY_DSN=
# Client (browser) DSN. MUST be NEXT_PUBLIC_* to be inlined into the browser bundle;
# instrumentation-client.ts cannot read the non-public SENTRY_DSN at runtime in the browser.
# Set this (typically to the same DSN value) or client-side errors are silently dropped.
NEXT_PUBLIC_SENTRY_DSN=
# CI-only secret enabling source-map upload to Sentry (no-ops if unset).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cron / Webhooks
CRON_SECRET=
CLERK_WEBHOOK_SECRET=     # Shared bearer secret: Next.js Clerk webhook route -> Convex /api/webhook/clerk. Set the SAME value in BOTH the Next.js and Convex envs.
WEBHOOK_SECRET=           # Legacy secret still read by convex/crawl/tasks.ts (stats aggregation). Keep until that path migrates to its own secret.
CONVEX_AUTH_TOKEN=        # Deploy key / authentication token for crawl ingestion (/ingest)
INTERNAL_API_SECRET=      # Shared secret authorizing the Next.js semantic-cache write path -> Convex cache.set.setFromServer

# Admin Bootstrap — set to the email of the first admin user
# This user is auto-promoted to admin on first login or webhook sync.
# After bootstrap, use /admin/users to manage roles via Clerk Backend API.
ADMIN_BOOTSTRAP_EMAIL=

# Clerk JWT Template (one-time manual setup):
# 1. Clerk Dashboard → Sessions → Customize session token → Claims
# 2. Add: { "metadata": "{{user.public_metadata}}" }
# This makes sessionClaims.metadata.role available in middleware + client.
# Required for: edge-level admin role check, admin UI role display.
CRAWL_WEBHOOK_SECRET=
CRAWL4AI_BASE_URL=http://localhost:11235
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Knowledge Store backend (Turso migration evaluation — see convex/knowledgeStore/)
# "convex" (default if unset) or "turso". Unrecognized values throw rather than
# silently falling back. Not wired into production retrieval/ingestion yet —
# only consumed by convex/knowledgeStore/index.ts's benchmark-facing factory.
KNOWLEDGE_STORE_BACKEND=convex
# Required only when KNOWLEDGE_STORE_BACKEND=turso. libsql://<db>.turso.io for
# Cloud, or file:./local.db for local testing (see tursoSchema.sql).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Zilliz Cloud (candidate vector store, evaluated after Turso - see
# convex/knowledgeStore/). Free-tier cluster's Public Endpoint + API key from
# the Zilliz Cloud console. Not read by production code paths.
ZILLIZ_ENDPOINT=
ZILLIZ_API_KEY=