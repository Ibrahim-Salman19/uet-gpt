# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk Authentication
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SIGNING_SECRET=
CLERK_JWT_ISSUER=          # From Clerk dashboard → JWT Templates

# LLM Providers
GROQ_API_KEY=               # Free tier: 6K TPM / 1K RPD (no card) or 30K TPM / 1K RPD (Developer plan, card required, $0)
CEREBRAS_API_KEY=           # Free tier: 1M tokens/day, 30 req/min, 8K context
GEMINI_API_KEY=             # Gemini Embedding + Gemini 3.5 Flash; free tier available

# Rate Limiting (Upstash Redis — rate limit only; semantic cache is Convex-native)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring
SENTRY_DSN=

# Cron / Webhooks
CRON_SECRET=

# Admin
ADMIN_EMAILS=               # Comma-separated list of admin email addresses
