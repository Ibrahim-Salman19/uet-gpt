# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk Authentication
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SIGNING_SECRET=
CLERK_JWT_ISSUER=

# LLM Providers
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=           # Primary Gemini API key (used for embeddings + chat fallback)
GEMINI_API_KEY_1=         # First rotation key (embeddings only)
GEMINI_API_KEY_2=         # Second rotation key (embeddings only)
GOOGLE_GENERATIVE_AI_API_KEY=  # Final rotation key (embeddings only)

# Rate Limiting (Upstash Redis — rate limit only; semantic cache is Convex-native)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring
SENTRY_DSN=

# Cron / Webhooks
CRON_SECRET=
WEBHOOK_SECRET=           # Shared secret for Next.js Clerk webhook route to Convex mutation auth
CONVEX_AUTH_TOKEN=        # Deploy key / authentication token for crawl ingestion (/ingest)

# Admin Bootstrap — set to the email of the first admin user
# This user is auto-promoted to admin on first login or webhook sync.
# After bootstrap, use /admin/users to manage roles via Clerk Backend API.
ADMIN_BOOTSTRAP_EMAIL=

# Clerk JWT Template (one-time manual setup):
# 1. Clerk Dashboard → Sessions → Customize session token → Claims
# 2. Add: { "metadata": "{{user.public_metadata}}" }
# This makes sessionClaims.metadata.role available in middleware + client.
# Required for: edge-level admin role check, admin UI role display.
CRAWL_WEBHOOK_SECRET=
CRAWL4AI_BASE_URL=http://localhost:11235
NEXT_PUBLIC_APP_URL=http://localhost:3000