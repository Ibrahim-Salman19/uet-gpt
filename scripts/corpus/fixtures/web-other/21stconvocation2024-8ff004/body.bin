    <link rel="stylesheet" href="/cssuetauto/firstvisitpopup.css?s=2" type="text/css" />
    <script type="5a1e85b58b668adbc5b0d718-text/javascript" src="/jsuetauto/jquery.firstVisitPopup.js?s=1"></script>
    <script type="5a1e85b58b668adbc5b0d718-text/javascript" src="/jsuetauto/uetautomated.js?s=9"></script>     
    <script type="5a1e85b58b668adbc5b0d718-text/javascript">
        /*****************************************************************************************/
        var gotoTopButton;
        /*****************************************************************************************/
        window.onload = function () {
            gotoTopButton = document.getElementById("gotoTopButton");
            //scrollFunction();
            // When the user scrolls down 20px from the top of the document, show the button
            window.onscroll = function () {
                scrollFunction();
                //setStickyMenu();
            };
            var menuItems = document.getElementsByClassName('dropdown');
            for (var i = 0; i < menuItems.length; i++) {
                menuItems[i].addEventListener('click', menuItemClicked);
            }
            setTimeout(function () {
                var searchbar = document.getElementById('st-launcher-tab');
                if (searchbar != null)
                    searchbar.remove();
            }, 3000);
            document.querySelectorAll("a:not(a[href])").forEach(element => {
                element.setAttribute("tabindex", "0")
            });
            //lnkSubmissionsHome
            document.getElementById('lnkSubmissionsHome').addEventListener('click', function(){
                var elem = document.getElementById('alinksubmission');
                elem.click();
                elem.focus();
            });
        }
        /*****************************************************************************************/
        function scrollFunction() {
            if (document.body.scrollTop > 150 || document.documentElement.scrollTop > 150) {
                gotoTopButton.style.display = "block";
            } else {
                gotoTopButton.style.display = "none";
            }
        }
        /*****************************************************************************************/
        function setStickyMenu() {
            var menu = document.getElementById('sitemenu');
            var bodyContent = document.getElementById('bodycontent');
            var offset = menu.offsetTop;
            if (document.body.scrollTop > offset || document.documentElement.scrollTop > offset) {
                menu.style.position = 'fixed';
                menu.style.top = 0;
                //bodyContent.style.marginTop = '150px';
            }
            else {
                menu.style.position = 'relative';
                menu.style.top = 0;
                //bodyContent.style.marginTop = '0px';
            }
        }
        /*****************************************************************************************/
        // When the user clicks on the button, scroll to the top of the document
        function topFunction() {
            document.body.scrollTop = 0; // For Safari
            document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
        }
        /*****************************************************************************************/
        function menuItemClicked(e) {
            var href = e.target.getAttribute('data-href');
            var targetDivId = href.substr(href.lastIndexOf('#') + 1);
            var x = document.getElementById(targetDivId);

            var contentdivs = document.getElementsByClassName('mainpara');
            for (var i = 0; i < contentdivs.length; i++) {
                contentdivs[i].className = "mainpara hide";
            }
            x.className = "mainpara show";
        }
        /*****************************************************************************************/

        /*****************************************************************************************/
    </script>
</head>
