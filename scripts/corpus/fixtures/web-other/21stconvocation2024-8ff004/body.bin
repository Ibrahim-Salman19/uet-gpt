<style type="text/css">
    .btnstyle {
        font-size: 18px;
        font-weight: bold;
        padding: 10px;
        color: blueviolet !important;
    }

    .btnstyle2 {
        font-size: 18px;
        font-weight: bold;
        padding: 10px;
        color: darkblue !important;
    }

    .box {
        font-size: 16px !important;
    }

    .convul {
        padding: 20px 40px !important;
        background-color: white;
        display: inline-block;
        border-radius: 40px;
    }

        .convul li {
            padding: 8px !important;
            list-style-type: disc !important;
        }

            .convul li p {
                color: black;
            }

            .convul li a {
                display: inline-block;
                padding: 10px !important;
                float: none !important;
                display: inline;
                border-radius: 0 !important;
                color: blue !important;
                font-weight: bold !important;
                padding: 0 !important;
                margin: 5px;
            }

    .convulinner {
        padding: 0px 20px !important;
        background-color: whitesmoke;
        display: inline-block;
    }

        .convulinner li {
            padding: 5px !important;
            list-style-type: disc !important;
        }

            .convulinner li p {
                color: black;
            }

    .onediv {
        clear: both;
        padding: 0px 0px 50px 0px;
        background-color: whitesmoke;
        text-align: center;
        margin-bottom: 50px;
        display: inline-block;
        width: 100%;
    }

    .sectionheading {
        text-align: center;
        font-weight: bold;
        font-size: 24px;
        color: black;
    }

    .sectioncontent {
        padding: 10px 30px;
        text-align: left;
    }

    .medalistsheading {
        text-align: center;
        padding: 15px;
        font-size: 25px;
        margin-bottom: 0px;
        font-weight: bold;
        color: black;
        background: lightgray;
        font-family: 'Calibri';
    }

    .alertmessage {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
        font-size: 20px;
        padding: 18px;
    }

    .studentdata th {
        font-weight: bold;
    }

    .studentdata td {
        vertical-align: middle !important;
    }

    .picturebox {
        text-align: center;
        height: 150px;
        width: 150px;
        box-shadow: 0px 0px 6px #6495ed;
    }

    .pictureimg {
        max-width: 100%;
        max-height: 100%;
    }

    .scholarstable {
    }

        .scholarstable td p {
            font-size: 15px;
        }

        .scholarstable tr td:nth-child(2) {
            white-space: nowrap;
        }

        .scholarstable tr td:nth-child(5) {
            white-space: nowrap;
        }

    .convocationtable {
        color: black;
    }

        .convocationtable td {
            padding: 5px;
        }

    .datetd {
        background-color: lightgreen;
    }

    .convocationtable td h3 {
        font-weight: bold;
        font-size: 18px;
        text-align: center;
    }

    .convocationtable td h4 {
        font-weight: bold;
        font-size: 16px;
        text-align: center;
    }

    .convocationtable td ul {
        padding-left: 15px;
    }

        .convocationtable td ul li {
            list-style-type: lower-roman;
        }
</style>
<div class="container" id="bodycontent">
    <div>
        <div class="mainpara show" id="home">
            <div class="mainheadingdiv">
                <div class="mainheadingdivinner">
                    <h2 class="mainparaheading">
                        The University is organizing its 21<sup style="bottom: 2ex; font-size: 15px;">st</sup> Convocation-2024 on <strong>05-06 January-2024 </strong>at
                        <strong>UET Taxila.</strong>
                    </h2>
                </div>
            </div>
            <div class="onediv">
                <h4 class="sectionheading">Eligible Candidates</h4>
                <div class="sectioncontent">
                    <ul class="convul">
                        <li>
                            <p>
                                The Graduates of Entry-2019 (Main Campus Taxila and Sub-Campus Chakwal) who have completed their BSc/BS Degrees
                                from the University up till 11-Dec-2023 and the Graduates from previous Entries who have completed their Degrees
                                after the last Convocation (20th Convocation held on 26-Jan-2023<strong>).</strong>
                            </p>
                        </li>
                        <li>
                            <p>
                                The Graduates who have completed their MS/MSc &amp; PhD Degrees from the University up till 11-Dec-2023 after the last Convocation
                                (20th Convocation held on 26-Jan-2023<strong>).</strong>
                            </p>
                        </li>
                        <li>
                            <p>
                                The Graduates of the <strong>Affiliated Institutes (APCOMS, SWEDISH, KICSIT)</strong>.
                            </p>
                        </li>
                        <li>
                            <p>
                                Only those Graduates will be allowed to attend the Convocation ceremony who will submit their Willingness Form ONLINE
                                (<a href="https://forms.office.com/r/EPc8aHSxAE">https://forms.office.com/r/EPc8aHSxAE</a> or web.uettaxila.edu.pk)
                                up till <strong>26-Dec-2023 </strong>and will also attend the <strong>Rehearsal </strong>on <strong>05-Jan-2024</strong>.
                                <br />
                                Entry cards and Invitation cards for guests will be issued on the day of rehearsal. There will be no entry in
                                Convocation ceremony without Entry card.
                            </p>
                        </li>
                        <li>
                            <p>
                                <em>
                                    Graduates of Affiliated Institutes will submit the Willingness Form in
                                    their respective Institute as per their own rules.
                                </em>
                            </p>
                        </li>
                    </ul>
                </div>
            </div>
            <p>&nbsp;</p>
        </div>

        <div class="mainpara" id="schedule">
            <div class="mainheadingdiv">
                <div class="mainheadingdivinner">
                    <h2 class="mainparaheading">Schedule</h2>
                </div>
            </div>
            <div class="onediv">
                <div class="sectioncontent">
                    <table class="table table-striped convocationtable" style=" border-collapse: collapse;">
                        <tr>
                            <td colspan="2" class="alert alert-success">
                                <h3>5th January-2024 (Rehearsal Day)</h3>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <h4>1. Students Registration (Convocation Entry card Collection):</h4>
                            </td>
                        </tr>
                        <tr>
                            <td>Timings:</td>
                            <td>08:45 am to 12:30 pm</td>
                        </tr>
                        <tr>
                            <td>Venue:</td>
                            <td>Central Library UET Taxila</td>
                        </tr>
                        <tr>
                            <td style="white-space: nowrap">Documents Required:</td>
                            <td>
                                <ul>
                                    <li><p>Transcript of Awards (One attested photocopy)</p></li>
                                    <li><p>Provisional Certificate (One attested photocopy)</p></li>
                                    <li><p>Computerized National Identity Card (Original and one attested photocopy)</p></li>
                                    <li><p>Two Recent Photographs 1"x1" Size (Registration No. and Name on backside)</p></li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <h4>2. Gown Collection (For Students): </h4>
                            </td>
                        </tr>
                        <tr>
                            <td>Timings:</td>
                            <td>08:45 am to 12:30 pm</td>
                        </tr>
                        <tr>
                            <td>Venue:</td>
                            <td>Central Library UET Taxila </td>
                        </tr>
                        <tr>
                            <td>Documents Required:</td>
                            <td>
                                <p>
                                    Rs. 1000/- as rent-cum-security on the day of rehearsal. The security will be refunded on return
                                    of the robes by deducting the rent after the Convocation ceremony.
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <h4>3. Guest Card Collection:  </h4>
                            </td>
                        </tr>
                        <tr>
                            <td>Timings:</td>
                            <td>08:45 am to 12:30 pm</td>
                        </tr>
                        <tr>
                            <td>Venue:</td>
                            <td>Central Library UET Taxila</td>
                        </tr>
                        <tr>
                            <td>Documents Required:</td>
                            <td>
                                <p>
                                    Submit/show original payment receipt while collecting Guest Entry Card.
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <h4>4. Rehearsal:  </h4>
                            </td>
                        </tr>
                        <tr>
                            <td>Timings:</td>
                            <td>01:45 pm </td>
                        </tr>
                        <tr>
                            <td>Venue:</td>
                            <td>Multipurpose Hall UET Taxila</td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <div class="alert alert-warning">
                                    <p>Note: Attendance in Rehearsal is mandatory, failing which students wouldn’t be allowed to attend convocation.</p>
                                    <p>(All faculty members are requested to follow the rehearsal timings)</p>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="alert alert-success">
                                <h3>6th January-2024 (Convocation Day)</h3>
                            </td>
                        </tr>

                        <tr>
                            <td>Timings:</td>
                            <td>08:45 am <b>(All entry gates will be closed at 09:45 am)</b></td>
                        </tr>
                        <tr>
                            <td>Venue:</td>
                            <td>Multipurpose Hall UET Taxila</td>
                        </tr>
                        <tr>
                            <td>Documents Required:</td>
                            <td>
                                <ul>
                                    <li><p>Convocation Entry Cards <b>(For Students only)</b></p></li>
                                    <li><p>Guest Invitation Cards <b>(For Guests only)</b></p></li>
                                    <li><p>University Cards & Security Cards, Issued by Directorate of Admin & Security of UET Taxila <b>(For Organizers only)</b></p></li>
                                    <li><p>Original CNIC <b>(For all above Categories)</b></p></li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <div class="alert alert-warning">
                                    <p> Note: All participants are required to follow the timings strictly.</p>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <div class="alert-success">
                                    <p style="padding: 30px;">Note: Parents of a medalist may attend the convocation without any Payment.</p>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <p>&nbsp;</p>
        </div>

