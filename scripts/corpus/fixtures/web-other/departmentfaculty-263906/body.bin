

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>DepartmentFaculty</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <script src="/js/jquery.min.js" type="41b34c835ee0670aa24832cd-text/javascript"></script>
    <style type="text/css">
        body {
            font-family: Verdana, Arial, Helvetica, sans-serif;
        }

        .pagecontaier {
            margin: 0 10%;
        }

        #FacultyPageHtml {
        }

        .depttitle {
            color: #1E8CBF;
            font-size: 24px;
            background-color: white;
            border: none;
            width: 100%;
        }

        .sharedfacultydiv::before {
            border: solid 1px green;
            margin: 20px 0px;
            width: 100%;
        }

        .sharedfacultydiv {
        }

        .sharedfacultydiv h2 {
            border: 1px solid #DDDDDD;
            font-size: 13px;
            font-weight: bold;
            color: #ffffff;
            padding: 10px;
            background: linear-gradient(to right, #002163,darkgray);
            border-radius: 5px;
            margin: 10px 0px;
        }

        .designationdiv h2 {
            border: 1px solid #DDDDDD;
            font-size: 18px;
            font-weight: bold;
            color: #ffffff;
            padding: 10px;
            background-color: #1E8CBF;
            border-radius: 5px;
            margin: 10px 0px;
        }

        .designationdiv h2 span {
            padding-left: 5px;
            color: white;
        }

        .hecapprovedphdsupervisor {
            font-weight: bold;
            font-family: Calibri;
            font-size: 14px;
        }

        .facultyprofilescontainer {
        }

        .facultyprofilescontainer div.profileDetailsTable:nth-child(even) {
            margin-left: 2%;
        }

        .profileDetailsTable {
            border: solid 2px #1E8CBF;
            border-top-right-radius: 25px;
            border-bottom-right-radius: 1px;
            margin-top: 6px;
            background: linear-gradient(#EBEBEB, #FBFBFB);
            padding: 5px;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 11px;
            width: 49%;
            display: inline-block;
        }

        .highestqualification {
            display: inline-block;
            padding-top: 5px;
        }

        .facultydata {
        }

        .fullname {
            color: #337ab7;
            font-size: 14px;
            font-weight: 700;
            text-decoration: underline;
        }

        .leavemark {
            font-weight: bold;
            color: #1E8CBF;
            font-size: 16px;
        }

        .profileImg {
            box-shadow: 1px 4px 10px #666;
            border-radius: 100%;
        }
        .actingchairman {
            font-weight: bold;
            color: green;
            font-size: 16px;
            padding-left: 5px;
        }
    </style>
    <script type="41b34c835ee0670aa24832cd-text/javascript">
        $(function () {
            var departmentId = parseInt($('#hiddepartmentid').val());
            if (departmentId == 16 || departmentId == 19) {
                $('.designationdiv h2').each(function (index, item) {
                    if ($(item).html() == 'Chairman') {
                        $(item).html('Incharge');
                    }
                })
            }
            //if (departmentId == 14) {
            //    $('.fullname').each(function (index, item) {
            //        debugger;
            //        if ($(item).html() == 'Dr. Muddassir Ali') {
            //            $('<span class="actingchairman">(Acting Chairman)</span>').insertAfter($(item));
            //        }
            //    })
            //}            
            //Fix issue of Getting Designation Abbreviation // The C# code is returning Assoc. Prof. when called for Assistant Professor
            $('.profileDetailsTable a').each(function(index, item){
                if($(item).html() == 'Assoc. Prof. Dr. Naila Maqsood'){
                    $(item).html('Asst. Prof. Dr. Naila Maqsood');
                }
            });

            $('.fullname').each(function (index, item) {
                var name = $(this).html();
                if (name.length > 32) {
                    name = name.substr(0, name.lastIndexOf(' '));
                    $(this).html(name);
                }
            });
            $('.facultyname').each(function (index, item) {
                if ($(this).height() > 30) {
                    $(this).css('zoom', '0.9');
                }
            });
            //Remove Empty Spans
            $('span.leavemark').each(function () {
                if ($(this).html() == '') {
                    $(this).remove();
                }
            });
            //Remove Leave Status Legends from Page Footer if there isn't any faculty on leave
            $('.leavestatusmark').each(function (index, item) {
                var leaveMark = $('span:first', this);
                var strLeaveMark = $(leaveMark).html();
                var anyRecordFound = false;
                $('.leavemark').each(function (leavemarkindex, leavemarkitem) {
                    if ($(leavemarkitem).html() == strLeaveMark) {
                        anyRecordFound = true;
                        return;
                    }                        
                });
                if (anyRecordFound == false) {
                    $(this).remove();
                }
            });
            //Remove hecapprovedphdsupervisor
            $('span.hecapprovedphdsupervisor').each(function () {
                if ($(this).html() == '') {
                    $(this).parent().remove();
                }
            });
            //Limit Specialization
            $('span.specialization').each(function () {
                if ($(this).html().length > 200) {
                    var limitedStr = $(this).html().substr(0, 200) + " ...";
                    $(this).html(limitedStr);
                }
            });
            //Set Height of each box same
            var maxHeight = 0;
            $('.profileDetailsTable').each(function () {
                var height = $(this).height();
                if (height > maxHeight)
                    maxHeight = height;
            });
            $('.profileDetailsTable').height(maxHeight);
        });

        window.onload = function (o) {
            o.style.height = (o.contentWindow.document.body.scrollHeight + 415) + "px";
        }
    </script>
</head>
