<!-- Simple Popup Script - Shows immediately when page loads -->
<script type="3fbea16f65bacec2e83fd49f-text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Show popup immediately (no delay)
    const modal = new bootstrap.Modal(document.getElementById('admissionPopup'), {
        backdrop: 'static',
        keyboard: true
    });
    modal.show();

    // Optional: Don't show again for 24 hours on same device
    localStorage.setItem('popupLastShown', Date.now().toString());
});

</script>
