{
  "framework": "nextjs",
  "buildCommand": "npx convex codegen && pnpm build",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "functions": {
    "src/app/api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/health/route.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "src/app/api/webhooks/**/*.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "github": {
    "silent": true,
    "autoJobCancelation": true
  }
}
